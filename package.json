{
  "name": "radio-log",
  "version": "0.6.5",
  "description": "Offline amateur radio logbook / Офлайн-журнал радіоаматора / Offline-Amateurfunk-Logbuch",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "bench:emrg": "tsc -p tsconfig.test.json && node scripts/emrg-black-sky-bench.mjs",
    "bench:channel": "tsc -p tsconfig.test.json && node scripts/sens-radio-channel-bench.mjs",
    "bench:modems": "tsc -p tsconfig.test.json && node scripts/sens-radio-modem-compare.mjs",
    "bench:sync": "tsc -p tsconfig.test.json && node scripts/sens-radio-sync-bench.mjs",
    "bench:gpu-candidates": "tsc -p tsconfig.test.json && node scripts/sens-radio-gpu-cpu-baseline.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2",
    "ft8js": "^0.0.3",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
